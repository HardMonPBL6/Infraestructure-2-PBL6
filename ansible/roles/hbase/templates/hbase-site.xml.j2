<?xml version="1.0"?>
<?xml-stylesheet type="text/xsl" href="configuration.xsl"?>
<!--
  hbase-site.xml — generado por Ansible (roles/hbase).
  Modo distribuido single-RS: ZK embebido en master, HFiles en filesystem local
  (file:///var/hbase-data en volumen Docker hbase-data en node-01).
-->
<configuration>

  <!-- Directorio raíz en HDFS (nube local, accesible vía WireGuard) -->
  <property>
    <name>hbase.rootdir</name>
    <value>{{ hbase_hdfs_rootdir }}</value>
  </property>

  <property>
    <name>hbase.cluster.distributed</name>
    <value>true</value>
  </property>

  <!-- ZooKeeper embebido: lista de IPs internas de los 3 nodos gcp-b -->
  <property>
    <name>hbase.zookeeper.quorum</name>
    <value>{{ hbase_zk_internal_quorum }}</value>
  </property>

  <property>
    <name>hbase.zookeeper.property.clientPort</name>
    <value>{{ hbase_zk_client_port }}</value>
  </property>

  <property>
    <name>hbase.zookeeper.property.dataDir</name>
    <value>{{ hbase_zk_data_dir }}</value>
  </property>

  <!-- Cada nodo anuncia su IP interna GCP-B (no la de WireGuard) -->
  <property>
    <name>hbase.regionserver.hostname</name>
    <value>{{ ansible_default_ipv4.address }}</value>
  </property>

  <!-- Master en node-01 (IP interna 10.30.1.10) -->
  <property>
    <name>hbase.master.hostname</name>
    <value>10.30.1.10</value>
  </property>

  <!-- Puertos estándar -->
  <property>
    <name>hbase.master.port</name>
    <value>16000</value>
  </property>

  <property>
    <name>hbase.master.info.port</name>
    <value>16010</value>
  </property>

  <property>
    <name>hbase.regionserver.port</name>
    <value>16020</value>
  </property>

  <property>
    <name>hbase.regionserver.info.port</name>
    <value>16030</value>
  </property>

  <!-- Heap del RegionServer (controlado desde group_vars) -->
  <property>
    <name>hbase.regionserver.global.memstore.size</name>
    <value>0.4</value>
  </property>

  <!-- Tamaño de bloque HDFS — coincide con blocksize del cluster HDFS (256 MB) -->
  <property>
    <name>hbase.hregion.max.filesize</name>
    <value>10737418240</value>
  </property>

  <!-- Compresión Snappy para HFiles si está disponible -->
  <property>
    <name>hbase.hregion.compression</name>
    <value>NONE</value>
  </property>

  <!-- file:// en overlay FS de Docker no soporta hflush.
       Deshabilitamos el check; para una capa batch de métricas la durabilidad
       del WAL no es crítica (datos recuperables desde HDFS/MapReduce). -->
  <property>
    <name>hbase.wal.provider</name>
    <value>filesystem</value>
  </property>

  <property>
    <name>hbase.unsafe.stream.capability.enforce</name>
    <value>false</value>
  </property>

  <!-- REST server: API en 8085, info UI en 8086 (evita colisión por defecto) -->
  <property>
    <name>hbase.rest.port</name>
    <value>{{ hbase_rest_port }}</value>
  </property>

  <property>
    <name>hbase.rest.info.port</name>
    <value>8086</value>
  </property>

</configuration>
