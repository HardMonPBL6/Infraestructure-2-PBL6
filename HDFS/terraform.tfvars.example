# ============================================================
#  FASE 1 · terraform.tfvars  — ⚠ NO commitear
# ============================================================

# Proxmox API
proxmox_api_url          = "https://10.10.1.15:8006/api2/json"
proxmox_api_token_id     = "iker@pam!tofu-token"
proxmox_api_token_secret = "REVOCAR-Y-REGENERAR"   # el que pegaste en chat: rota'lo

proxmox_ssh_user = "root"

# Nodos Proxmox (CONFIRMAR los nombres reales que aparecen en la UI)
proxmox_node_0 = "pve-local"
proxmox_node_1 = "pve-local2"
proxmox_node_2 = "pve-local3"

# Plantilla LXC
lxc_ostemplate = "local:vztmpl/debian-13-standard_13.1-2_amd64.tar.zst"

# Recursos y storage (CONFIRMAR storage real: local-lvm / local-zfs / ...)
lxc_storage   = "local-lvm"
lxc_cores     = 2
lxc_memory_mb = 2048
lxc_disk_gb   = 20

# Red
lxc_bridge  = "vmbr0"
lxc_gateway = "10.10.1.1"   # CONFIRMAR gateway real de 10.10.1.0/24

# SSH a los LXC (genera el par si no lo tienes:
#   ssh-keygen -t ed25519 -f ~/.ssh/webhardmon-lxc)
ssh_public_key       = "ssh-ed25519 AAAA... iker@mgmt"   # contenido de la .pub
ssh_private_key_path = "/home/iker/.ssh/webhardmon-lxc"

# Harbor
harbor_registry = "10.10.1.50:5000"
