# Copia este fichero a `terraform.tfvars` y rellena los valores.
# `terraform.tfvars` esta en .gitignore — NO subir secretos al repo.

# ---- Proxmox ----------------------------------------------------------------
proxmox_endpoint        = "https://10.10.1.15:8006/"
proxmox_api_token       = "tofu@pve!webhardmon=00000000-0000-0000-0000-000000000000"
proxmox_ssh_private_key = <<EOT
-----BEGIN OPENSSH PRIVATE KEY-----
...
-----END OPENSSH PRIVATE KEY-----
EOT
local_ct_ssh_pubkey     = "ssh-ed25519 AAAA... usuario@laptop"

# ---- GCP --------------------------------------------------------------------
gcp_a_project_id       = "webhardmon-a-XXXXX"
gcp_a_credentials_file = "C:/Users/sebastian/.gcp/webhardmon-a.json"

gcp_b_project_id       = "webhardmon-b-XXXXX"
gcp_b_credentials_file = "C:/Users/sebastian/.gcp/webhardmon-b.json"

# ---- GCP opciones de coste --------------------------------------------------
# Por defecto: 3 VMs spot e2-standard-4 por nube, DELETE al ser interrumpidas.
# Cada VM co-aloja varios servicios (contenedores). Override si hace falta:
# gcp_spot                    = true            # spot ON por defecto
# gcp_spot_termination_action = "DELETE"        # "STOP" conserva el disco
# gcp_default_machine_type    = "e2-standard-4"
# gcp_node_disk_gb            = 30
#
# Reparto de servicios por nodo (override solo si quieres otra distribucion):
# gcp_a_nodes = [
#   { roles = ["kafka", "zookeeper", "cassandra", "schema_registry"],     public = true  },
#   { roles = ["kafka", "zookeeper", "cassandra", "java", "java_bridge"], public = false },
#   { roles = ["kafka", "zookeeper", "cassandra", "java"],                public = false },
# ]
# (java = nodos RMI StressScore; java_bridge = el puente Kafka->RMI->Cassandra, 1 instancia)
# gcp_b_nodes = [
#   { roles = ["hbase", "grafana", "web"], public = true  },
#   { roles = ["hbase", "mysql"],          public = false },
#   { roles = ["hbase", "elasticsearch"],  public = false },
# ]
# (web = panel WebHardMon, capa service; lee MySQL local y Cassandra de gcp-a)

# ---- WireGuard VPN inter-nube -----------------------------------------------
# Genera los keypairs con estos comandos (uno por gateway):
#   wg genkey | tee gcp-a-private.key | wg pubkey > gcp-a-public.key
#   wg genkey | tee gcp-b-private.key | wg pubkey > gcp-b-public.key
#   wg genkey | tee mgmt-private.key  | wg pubkey > mgmt-public.key
#   wg genkey | tee local-gw-private.key | wg pubkey > local-gw-public.key
# Las claves privadas del nodo de gestion y el gateway local se configuran
# manualmente en esos hosts (fuera de OpenTofu).

wg_gcp_a_private_key   = "base64privkeyA=="
wg_gcp_a_public_key    = "base64pubkeyA=="
wg_gcp_b_private_key   = "base64privkeyB=="
wg_gcp_b_public_key    = "base64pubkeyB=="
wg_mgmt_public_key     = "base64pubkeyMgmt=="
wg_local_gw_public_key = "base64pubkeyLocal=="
# wg_mgmt_endpoint     = "ddns.example.com"   # IP/DNS del portatil; omitir si usa keepalive
# wg_local_gw_endpoint = "1.2.3.4"            # IP publica del gateway local

# ---- Cloudflare Tunnel (ingesta externa de los collectors) ------------------
# Publica el endpoint de ingesta de NiFi en ingest.<zona> sin abrir NAT/VPN.
# Pon cloudflare_enabled = false para desactivarlo (no se crea ningun recurso CF).
cloudflare_enabled          = true
cloudflare_api_token        = "cf-api-token-..."          # Account: Cloudflare Tunnel:Edit + Access: Apps and Policies:Edit + Access: Service Tokens:Edit; Zone: DNS:Edit
cloudflare_account_id       = "0123456789abcdef0123456789abcdef"
cloudflare_zone_id          = "abcdef0123456789abcdef0123456789"
cloudflare_zone_name        = "example.com"
# cloudflare_ingest_subdomain = "ingest"                  # -> ingest.example.com
# nifi_ingest_port            = 8081                       # listener HTTP de NiFi
